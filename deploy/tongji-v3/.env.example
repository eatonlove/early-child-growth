COMPOSE_PROJECT_NAME=tongji_v3
TONGJI_V3_PORT=8300
SUPABASE_NETWORK=supabase_default

NODE_ENV=production
HOST=0.0.0.0
PORT=4310
TRUST_PROXY=true
COOKIE_SECURE=true
CORS_ORIGIN=https://tongji.meidaquan.com

SUPABASE_URL=https://rent-supabase.meidaquan.com
SUPABASE_INTERNAL_URL=http://supabase-envoy:8000
SUPABASE_PUBLISHABLE_KEY=copy_existing_ANON_KEY_without_printing_it
SUPABASE_SERVICE_ROLE_KEY=copy_existing_SERVICE_ROLE_KEY_without_printing_it
SUPABASE_SCHEMA=tongji_v3
SUPABASE_STORAGE_BUCKET=tongji-v3-evidence
INTERNAL_EMAIL_DOMAIN=tongji-v3.local
AI_MODE=simulated
# 启用千问：将 AI_MODE 改为 qianwen，并在服务器 .env 中填写标准 sk- 密钥。
DASHSCOPE_API_KEY=sk-your-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.7-plus
QWEN_VISION_MODEL=qwen3.7-plus
QWEN_TIMEOUT_MS=120000
QWEN_MEDIA_ANALYSIS_ENABLED=false
QWEN_MAX_MEDIA=2
AI_FALLBACK_TO_SIMULATED=true

# 仅首次初始化使用，完成后删除密码并重建api容器。
BOOTSTRAP_TENANT_CODE=xy-kindergarten
BOOTSTRAP_TENANT_NAME=向阳实验幼儿园
BOOTSTRAP_ADMIN_USERNAME=research.admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统教研员

# 复制为 ai.env 后填写标准千问 API 密钥。ai.env 已被 Git 忽略。
AI_MODE=qianwen
QIANWEN_API_KEY=sk-your-key-here

# 真实AI测试不允许静默退回模拟结果。
AI_FALLBACK_TO_SIMULATED=false

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.7-plus
QWEN_VISION_MODEL=qwen3.7-plus

# 默认只测试真实文本分析。启用图片/视频时，需用HTTPS隧道公开本地5300端口。
QWEN_MEDIA_ANALYSIS_ENABLED=false
QWEN_MAX_MEDIA=2
LOCAL_MEDIA_PUBLIC_BASE_URL=

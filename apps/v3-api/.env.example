NODE_ENV=production
HOST=0.0.0.0
PORT=4310
TRUST_PROXY=true
COOKIE_SECURE=true
CORS_ORIGIN=https://tongji.example.cn

# 共享Supabase项目。service role只能配置在后端容器中。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_SCHEMA=tongji_v3
SUPABASE_STORAGE_BUCKET=tongji-v3-evidence

# 登录账号username会映射为 username@tongji-v3.local，避免与共享Auth中的其他应用账号混淆。
INTERNAL_EMAIL_DOMAIN=tongji-v3.local
AI_MODE=simulated
# AI_MODE=qianwen 时使用标准按量付费 sk- 密钥；不要使用 sk-sp- Token Plan 密钥。
DASHSCOPE_API_KEY=sk-your-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.7-plus-2026-05-26
QWEN_VISION_MODEL=qwen3.7-plus-2026-05-26
QWEN_TIMEOUT_MS=120000
QWEN_VISION_TIMEOUT_MS=240000
# 发送幼儿图片/视频画面前还会校验监护授权必须为 granted。
QWEN_MEDIA_ANALYSIS_ENABLED=false
QWEN_WEB_SEARCH_ENABLED=true
QWEN_MAX_MEDIA=2
AI_FALLBACK_TO_SIMULATED=false

# 仅首次初始化管理员时使用，执行后从环境中移除。
BOOTSTRAP_TENANT_CODE=xy-kindergarten
BOOTSTRAP_TENANT_NAME=向阳实验幼儿园
BOOTSTRAP_ADMIN_USERNAME=research.admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统教研员
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe12345

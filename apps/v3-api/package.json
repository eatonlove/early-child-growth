{
  "name": "tongji-v3-api",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "smoke:authenticated": "tsx scripts/smoke-authenticated.ts",
    "seed:knowledge": "tsx scripts/seed-knowledge.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@supabase/supabase-js": "2.57.4",
    "dotenv": "17.2.2",
    "fastify": "5.12.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
